        LocalPlayer.Character.Humanoid.WalkSpeed = value
    end
end)

createSlider(playerCard, "Прыжок", 0, 200, Settings.JumpPower, function(value)
    Settings.JumpPower = value
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.JumpPower = value
    end
end)

createSlider(playerCard, "Размер", 0.1, 5, Settings.CharacterScale, function(value)
    Settings.CharacterScale = value
    if LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Size = part.Size * (value / Settings.CharacterScale)
            end
        end
    end
end)

createToggle(playerCard, "Невидимость", Settings.Invisible, function(value)
    Settings.Invisible = value
    if LocalPlayer.Character then
        for _, obj in ipairs(LocalPlayer.Character:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = value and 1 or 0
            end
        end
    end
end)

createToggle(playerCard, "Полет", Settings.FlyEnabled, function(value)
    Settings.FlyEnabled = value
    if value then
        startFly()
    else
        stopFly()
    end
end)

createSlider(playerCard, "Скорость полета", 10, 200, Settings.FlySpeed, function(value)
    Settings.FlySpeed = value
end)

createToggle(playerCard, "Анимация полета", Settings.FlyAnimation, function(value)
    Settings.FlyAnimation = value
end)

createToggle(playerCard, "Беск. прыжок", Settings.InfiniteJump, function(value)
    Settings.InfiniteJump = value
end)

createToggle(playerCard, "Noclip", Settings.NoclipEnabled, function(value)
    Settings.NoclipEnabled = value
    setupNoclip(value)
end)

createButton(playerCard, "Сбросить Player", function()
    Settings.Speed = 16
    Settings.JumpPower = 50
    Settings.CharacterScale = 1
    Settings.Invisible = false
    Settings.FlyEnabled = false
    Settings.FlySpeed = 50
    Settings.FlyAnimation = false
    Settings.InfiniteJump = false
    Settings.NoclipEnabled = false

    if LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 16
            humanoid.JumpPower = 50
        end
        for _, obj in ipairs(LocalPlayer.Character:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = 0
            end
        end
    end
    stopFly()
    setupNoclip(false)
    notify("Сброс", "Player сброшен", 2)
end)

